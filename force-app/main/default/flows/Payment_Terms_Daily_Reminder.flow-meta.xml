    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Client_Email_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Payment_Received__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Due_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Payment_Term__c</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-01-28</startDate>
            <startTime>09:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>tt_EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!$Record.Project__r.Client__r.FirstName},&lt;/p&gt;&lt;p&gt;This is a notification regarding the &lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!f_PaymentStatus}&lt;/strong&gt; payment for project &lt;strong&gt;{!$Record.Project__r.Name}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Status:&lt;/strong&gt; &lt;strong&gt;{!f_PaymentStatus}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Payment Details:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Term: {!$Record.Name}&lt;/p&gt;&lt;p&gt;Due Date: {!$Record.Due_Date__c}&lt;/p&gt;&lt;p&gt;Amount Due: {!$Record.Percentage__c}% of Project Value&lt;/p&gt;&lt;p&gt;Please ensure this payment is processed immediately.&lt;/p&gt;&lt;p&gt;Regards,&lt;/p&gt;&lt;p&gt;The Arelia Living Accounts Team&lt;/p&gt;</text>
    </textTemplates>
</Flow>
