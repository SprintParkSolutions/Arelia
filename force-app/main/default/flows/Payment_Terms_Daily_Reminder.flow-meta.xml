    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Check_Client_Email_Exists</name>
        <label>Check Client Email Exists</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Has_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Project__r.Client__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Due_Date_Proximity</targetReference>
            </connector>
            <label>Has Email</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Due_Date_Proximity</name>
        <label>Check Due Date Proximity</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>No Action Needed</defaultConnectorLabel>
        <rules>
            <name>Due_In_3_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_DaysUntilDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Due In 3 Days</label>
        </rules>
        <rules>
            <name>Due_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_DaysUntilDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Due Today</label>
        </rules>
        <rules>
            <name>Is_Overdue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>f_DaysUntilDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>-1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>f_DaysUntilDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>-3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>f_DaysUntilDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>-7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Is Overdue</label>
        </rules>
    </decisions>
    <description>Daily scheduled flow. Checks Due Soon, Due Today, and Overdue (-1, -3, -7 days). Checks Payment Received status at Start.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_DaysUntilDue</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Due_Date__c} - {!$Flow.CurrentDate}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_EmailSubject</name>
        <dataType>String</dataType>
        <expression>IF({!f_DaysUntilDue} &lt; 0, 
    &quot;OVERDUE: Payment Required for &quot; &amp; {!$Record.Project__r.Name}, 
    &quot;Payment Reminder: &quot; &amp; {!$Record.Project__r.Name})</expression>
    </formulas>
    <formulas>
        <name>f_PaymentStatus</name>
        <dataType>String</dataType>
        <expression>IF({!f_DaysUntilDue} &lt; 0, &quot;OVERDUE&quot;, &quot;Upcoming&quot;)</expression>
    </formulas>
    <label>Payment Terms: Daily Reminder</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
