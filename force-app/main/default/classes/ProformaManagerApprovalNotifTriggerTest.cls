    static void unapprovedInvoiceDoesNotEnqueuePush() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            false,
            false,
            null
        );

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update new Proforma_Invoice__c(
            Id = invoice.Id,
            Manager_Comments__c = 'Awaiting manager review.'
        );

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ZERO_JOBS,
            jobsCreated,
            'An unapproved invoice must not enqueue ' +
            'a manager approval push notification.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Manager_Approval__c,
                   Manager_Comments__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
