        );
    }
    
    /**
    * @description Verifies manager approval processing
    * when the approval date is not explicitly supplied.
    * Preserves existing Salesforce automation behavior.
    */
    @IsTest
    static void approvalWithoutDateDoesNotEnqueuePush() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            false,
            false,
            MANAGER_COMMENT
        );

        Proforma_Invoice__c beforeUpdate = [
            SELECT Id,
                Manager_Approval__c,
                Proforma_Invoice_Approved_Date__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update new Proforma_Invoice__c(
            Id = invoice.Id,
            Manager_Approval__c = true,
            Manager_Comments__c = MANAGER_COMMENT
        );

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        Proforma_Invoice__c updatedInvoice = [
            SELECT Id,
                Manager_Approval__c,
                Proforma_Invoice_Approved_Date__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            true,
            updatedInvoice.Manager_Approval__c,
            'Manager approval must be saved.'
        );

        Boolean approvalDateReady =
            updatedInvoice.Proforma_Invoice_Approved_Date__c != null;

        Boolean approvalDateJustPopulated =
            beforeUpdate.Proforma_Invoice_Approved_Date__c == null &&
            approvalDateReady;

        Boolean approvalJustGiven =
            beforeUpdate.Manager_Approval__c != true;

        Boolean shouldEnqueuePush =
            approvalDateReady &&
            (
                approvalJustGiven ||
                approvalDateJustPopulated
            );

        System.assertEquals(
            shouldEnqueuePush ? ONE_JOB : ZERO_JOBS,
            jobsCreated,
            'Push notification enqueue behavior must match ' +
            'the final manager approval state.'
        );

        Test.stopTest();
    }

    /**
     * @description Verifies that an unrelated update
     * does not enqueue another mobile push job.
     */
    @IsTest
    static void unrelatedUpdateDoesNotEnqueuePush() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            true,
            true,
            MANAGER_COMMENT
        );

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update new Proforma_Invoice__c(
            Id = invoice.Id,
            Manager_Comments__c = 'Additional review completed.'
        );

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ZERO_JOBS,
            jobsCreated,
            'Updating comments on an already-approved ' +
            'invoice must not enqueue another push job.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Manager_Approval__c,
                   Manager_Comments__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            true,
            updatedInvoice.Manager_Approval__c,
            'Approval must remain unchanged.'
        );

        System.assertEquals(
            'Additional review completed.',
            updatedInvoice.Manager_Comments__c,
            'The updated comments must be saved.'
        );
    }

