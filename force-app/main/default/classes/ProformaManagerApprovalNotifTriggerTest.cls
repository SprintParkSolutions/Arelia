@IsTest
private class ProformaManagerApprovalNotifTriggerTest {

    private static final String TEST_ACCOUNT_NAME =
        'Proforma Approval Test Account';

    private static final String TEST_OPPORTUNITY_NAME =
        'Proforma Approval Test Opportunity';

    private static final String STAGE_PROSPECTING =
        'Prospecting';

    private static final String MANAGER_COMMENT =
        'Approved by the manager.';

    private static final Integer ZERO_JOBS = 0;
    private static final Integer ONE_JOB = 1;
    private static final Integer BULK_RECORD_COUNT = 5;

    /**
     * @description Creates shared Account and Opportunity
     * records for the test methods.
     */
    @TestSetup
    static void setupTestData() {

        Account testAccount = new Account(
            Name = TEST_ACCOUNT_NAME
        );

        insert testAccount;

        Opportunity testOpportunity = new Opportunity(
            Name = TEST_OPPORTUNITY_NAME,
            AccountId = testAccount.Id,
            StageName = STAGE_PROSPECTING,
            CloseDate = Date.today().addDays(30)
        );

        insert testOpportunity;
    }

    /**
     * @description Retrieves the shared test Opportunity.
     */
    private static Id getOpportunityId() {

        Opportunity testOpportunity = [
            SELECT Id
            FROM Opportunity
            WHERE Name = :TEST_OPPORTUNITY_NAME
            LIMIT 1
        ];

        return testOpportunity.Id;
    }

    /**
     * @description Assigns the approval date using the
     * actual Salesforce field type.
     */
    private static void setApprovalDate(
        Proforma_Invoice__c invoice,
        Boolean populateDate
    ) {

        Schema.DescribeFieldResult fieldDescription =
            Proforma_Invoice__c.Proforma_Invoice_Approved_Date__c.getDescribe();

        if (!populateDate) {
            invoice.put(
                'Proforma_Invoice_Approved_Date__c',
                null
            );
            return;
        }

        if (
            fieldDescription.getType() ==
            Schema.DisplayType.DateTime
        ) {
            invoice.put(
                'Proforma_Invoice_Approved_Date__c',
                System.now()
            );
        } else {
            invoice.put(
                'Proforma_Invoice_Approved_Date__c',
                Date.today()
            );
        }
    }

    /**
    * @description Creates a Proforma Invoice with the specified manager approval state.
    * @param opportunityId Related Opportunity Id.
    * @param isApproved Manager approval state.
    * @param hasApprovedDate Whether approval date exists.
    * @param comments Manager comments.
    * @return Inserted Proforma Invoice record.
    */
    private static Proforma_Invoice__c createInvoice(Id opportunityId, Boolean isApproved, Boolean hasApprovedDate, String comments) {

        Proforma_Invoice__c invoice =
            new Proforma_Invoice__c(
                Opportunity__c = opportunityId,
                Manager_Approval__c = isApproved,
                Manager_Comments__c = comments
            );

        // Name is auto-generated by Salesforce.
        // Do not assign the read-only Name field.

        setApprovalDate(
            invoice,
            hasApprovedDate
        );

        insert invoice;

        return invoice;
    }

    /**
     * @description Returns the count of Queueable jobs
     * enqueued by the current transaction.
     */
    private static Integer getQueueableJobCount() {
        return Limits.getQueueableJobs();
    }

    /**
     * @description Verifies that manager approval with
     * an approval date enqueues a mobile push job.
     */
    @IsTest
    static void managerApprovalEnqueuesPushJob() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            false,
            false,
            MANAGER_COMMENT
        );

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        Proforma_Invoice__c invoiceUpdate =
            new Proforma_Invoice__c(
                Id = invoice.Id,
                Manager_Approval__c = true,
                Manager_Comments__c = MANAGER_COMMENT
            );

        setApprovalDate(invoiceUpdate, true);

        update invoiceUpdate;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ONE_JOB,
            jobsCreated,
            'Manager approval with an approval date ' +
            'must enqueue one mobile push job.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Manager_Approval__c,
                   Proforma_Invoice_Approved_Date__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            true,
            updatedInvoice.Manager_Approval__c,
            'Manager approval must be saved.'
        );

        System.assertNotEquals(
            null,
            updatedInvoice.Proforma_Invoice_Approved_Date__c,
            'Approval date must be populated.'
        );
    }

    /**
     * @description Verifies that an approval transition
     * with blank comments is eligible for email fallback
     * in a non-Site context.
     */
    @IsTest
    static void blankCommentsTriggersEmailFallback() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            false,
            false,
            null
        );

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        Proforma_Invoice__c invoiceUpdate =
            new Proforma_Invoice__c(
                Id = invoice.Id,
                Manager_Approval__c = true,
                Manager_Comments__c = null
            );

        setApprovalDate(invoiceUpdate, true);

        update invoiceUpdate;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ONE_JOB,
            jobsCreated,
            'The approval must still enqueue the ' +
            'mobile push notification.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Manager_Approval__c,
                   Manager_Comments__c,
                   Opportunity__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            true,
            updatedInvoice.Manager_Approval__c,
            'Manager approval must persist.'
        );

        System.assertEquals(
            null,
            updatedInvoice.Manager_Comments__c,
            'Manager comments must remain blank.'
        );

        System.assertNotEquals(
            null,
            updatedInvoice.Opportunity__c,
            'The invoice must retain its Opportunity.'
        );

        // The trigger invokes the fallback controller
        // when comments are blank in a non-Site context.
        // Email delivery requires separate verification.
    }

