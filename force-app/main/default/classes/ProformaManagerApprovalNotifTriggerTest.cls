    /**
    * @description Tests bulk manager approvals.
    * Verifies that one push job is enqueued for the
    * complete batch instead of one job per invoice.
    */
    @IsTest
    static void bulkManagerApprovalsEnqueueSinglePushJob() {

        Id opportunityId = getOpportunityId();

        List<Proforma_Invoice__c> invoices =
            new List<Proforma_Invoice__c>();

        for (
            Integer index = 0;
            index < BULK_RECORD_COUNT;
            index++
        ) {

            Proforma_Invoice__c invoice =
                new Proforma_Invoice__c(
                    Opportunity__c = opportunityId,
                    Manager_Approval__c = false,
                    Manager_Comments__c = MANAGER_COMMENT
                );

            // Name is automatically generated by Salesforce.

            invoices.add(invoice);
        }

        insert invoices;

        List<Proforma_Invoice__c> updates =
            new List<Proforma_Invoice__c>();

        for (Proforma_Invoice__c invoice : invoices) {

            Proforma_Invoice__c invoiceUpdate =
                new Proforma_Invoice__c(
                    Id = invoice.Id,
                    Manager_Approval__c = true
                );

            setApprovalDate(invoiceUpdate, true);

            updates.add(invoiceUpdate);
        }

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update updates;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ONE_JOB,
            jobsCreated,
            'Bulk manager approvals must enqueue ' +
            'only one push notification job.'
        );

        Test.stopTest();

        Set<Id> invoiceIds =
            new Map<Id, Proforma_Invoice__c>(
                invoices
            ).keySet();

        List<Proforma_Invoice__c> approvedInvoices = [
            SELECT Id,
                Manager_Approval__c,
                Proforma_Invoice_Approved_Date__c
            FROM Proforma_Invoice__c
            WHERE Id IN :invoiceIds
        ];

        System.assertEquals(
            BULK_RECORD_COUNT,
            approvedInvoices.size(),
            'Every test invoice must be present.'
        );

        for (Proforma_Invoice__c invoice : approvedInvoices) {

            System.assertEquals(
                true,
                invoice.Manager_Approval__c,
                'Every invoice must be approved.'
            );

            System.assertNotEquals(
                null,
                invoice.Proforma_Invoice_Approved_Date__c,
                'Every invoice must have an approval date.'
            );
        }
    }


    
    /**
    * @description Tests bulk updates containing multiple
    * manager approval states.
    * Verifies approval persistence and bulk push processing.
    */
    @IsTest
    static void mixedBulkUpdatesProcessEligibleInvoices() {

        Id opportunityId = getOpportunityId();

        Proforma_Invoice__c firstInvoice = createInvoice(
            opportunityId,
            false,
            false,
            MANAGER_COMMENT
        );

        Proforma_Invoice__c secondInvoice = createInvoice(
            opportunityId,
            false,
            false,
            MANAGER_COMMENT
        );

        Proforma_Invoice__c thirdInvoice = createInvoice(
            opportunityId,
            false,
            false,
            MANAGER_COMMENT
        );

        Proforma_Invoice__c firstUpdate =
            new Proforma_Invoice__c(
                Id = firstInvoice.Id,
                Manager_Approval__c = true
            );

        setApprovalDate(firstUpdate, true);

        Proforma_Invoice__c secondUpdate =
            new Proforma_Invoice__c(
                Id = secondInvoice.Id,
                Manager_Approval__c = false,
                Manager_Comments__c = 'Pending review.'
            );

        Proforma_Invoice__c thirdUpdate =
            new Proforma_Invoice__c(
                Id = thirdInvoice.Id,
                Manager_Approval__c = true
            );

        List<Proforma_Invoice__c> updates =
            new List<Proforma_Invoice__c>{
                firstUpdate,
                secondUpdate,
                thirdUpdate
            };

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update updates;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ONE_JOB,
            jobsCreated,
            'Bulk manager approvals must enqueue ' +
            'one mobile push notification job.'
        );

        Test.stopTest();

        Set<Id> invoiceIds = new Set<Id>{
            firstInvoice.Id,
            secondInvoice.Id,
            thirdInvoice.Id
        };

        Map<Id, Proforma_Invoice__c> results =
            new Map<Id, Proforma_Invoice__c>([
                SELECT Id,
                    Manager_Approval__c,
                    Proforma_Invoice_Approved_Date__c
                FROM Proforma_Invoice__c
                WHERE Id IN :invoiceIds
            ]);

        System.assertEquals(
            3,
            results.size(),
            'All three invoices must exist.'
        );

        Proforma_Invoice__c firstResult =
            results.get(firstInvoice.Id);

        Proforma_Invoice__c secondResult =
            results.get(secondInvoice.Id);

        Proforma_Invoice__c thirdResult =
            results.get(thirdInvoice.Id);

        System.assertEquals(
            true,
            firstResult.Manager_Approval__c,
            'First invoice must be approved.'
        );

        System.assertNotEquals(
            null,
            firstResult.Proforma_Invoice_Approved_Date__c,
            'First invoice must have an approval date.'
        );

        System.assertEquals(
            false,
            secondResult.Manager_Approval__c,
            'Second invoice must remain unapproved.'
        );

        System.assertEquals(
            true,
            thirdResult.Manager_Approval__c,
            'Third invoice approval must persist.'
        );

        System.assertNotEquals(
            null,
            thirdResult.Proforma_Invoice_Approved_Date__c,
            'Third invoice must have an approval date ' +
            'when the existing automation populates it.'
        );
    }

    /**
     * @description Verifies that an invoice without
     * an Opportunity does not enqueue a push job.
     *
     * This scenario applies only when the Opportunity
     * relationship can legally be cleared.
     */
    @IsTest
    static void missingOpportunityDoesNotEnqueuePush() {

        Schema.DescribeFieldResult relationshipField =
            Proforma_Invoice__c.Opportunity__c.getDescribe();

        if (!relationshipField.isNillable()) {
            return;
        }

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            false,
            false,
            MANAGER_COMMENT
        );

        Proforma_Invoice__c invoiceUpdate =
            new Proforma_Invoice__c(
                Id = invoice.Id,
                Opportunity__c = null,
                Manager_Approval__c = true
            );

        setApprovalDate(invoiceUpdate, true);

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        update invoiceUpdate;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ZERO_JOBS,
            jobsCreated,
            'An invoice without an Opportunity ' +
            'must not enqueue a push notification.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Opportunity__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            null,
            updatedInvoice.Opportunity__c,
            'Opportunity must remain unassigned.'
        );
    }
