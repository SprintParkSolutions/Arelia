    /**
     * @description Verifies that populating the approval
     * date after manager approval enqueues a push job.
     *
     * The email fallback must not run because the manager
     * approval flag is not newly changed to true.
     */
    @IsTest
    static void approvalDatePopulatedAfterApproval() {

        Proforma_Invoice__c invoice = createInvoice(
            getOpportunityId(),
            true,
            false,
            MANAGER_COMMENT
        );

        Test.startTest();

        Integer jobsBefore = getQueueableJobCount();

        Proforma_Invoice__c invoiceUpdate =
            new Proforma_Invoice__c(
                Id = invoice.Id
            );

        setApprovalDate(invoiceUpdate, true);

        update invoiceUpdate;

        Integer jobsCreated =
            getQueueableJobCount() - jobsBefore;

        System.assertEquals(
            ONE_JOB,
            jobsCreated,
            'Populating the approval date for an ' +
            'approved invoice must enqueue a push job.'
        );

        Test.stopTest();

        Proforma_Invoice__c updatedInvoice = [
            SELECT Manager_Approval__c,
                   Proforma_Invoice_Approved_Date__c
            FROM Proforma_Invoice__c
            WHERE Id = :invoice.Id
        ];

        System.assertEquals(
            true,
