<html>
 <head>
  <title></title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Dear <strong>Manager</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">We are pleased to inform you that a new project has been approved by <strong>{{{Site_Visit_Report__c.Supervisor_User__r.Name}}}</strong> for the following lead.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please review the lead and site visit report information below before proceeding with the next stage of the lead conversion process.</p> <!-- Lead Information -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Lead Information</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Lead Name</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Lead__r.FirstName}}} {{{Site_Visit_Report__c.Lead__r.LastName}}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Company</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Lead__r.Company}}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Email</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Lead__r.Email}}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Phone</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Lead__r.Phone}}}</td>
            </tr>
           </tbody>
          </table> <!-- Site Visit Report Information -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Site Visit Report Information</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Site Visit Report Number</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Name}}}</td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Site Visit Supervisor</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Supervisor_User__r.Name}}}</td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Site Visit Date</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Site_Visit_Date__c}}}</td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Site Visit Time Slot</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Site_Visit_Time_Slot__c}}}</td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Supervisor Final Estimated Cost</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>{{{Site_Visit_Report__c.Total_Estimated_Cost__c}}}</strong></td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Estimated Completion Months</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{{Site_Visit_Report__c.Estimated_Completion_Months__c}}}</td>
            </tr>
           </tbody>
          </table> <!-- Action Required -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Action Required</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please review the Site Visit Report and update the record as required before proceeding with the lead conversion approval process.</p> <!-- Report Button -->
          <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;
											  margin:22px 0 24px 0;">
           <tbody>
            <tr>
             <td align="center" style="background-color:#1b1b1b;
													   border:1px solid #c9a75d;
													   padding:12px 24px;
													   text-align:center;"><a href="{{{siteVisitRecordPageLink}}}" style="font-size:17px;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#ffffff;
														  text-decoration:none;
														  font-weight:bold;
														  display:inline-block;">Review Site Visit Report </a></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Once the review is complete, please proceed with the appropriate management decision for the lead conversion.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because a lead is ready for management review and conversion approval.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>