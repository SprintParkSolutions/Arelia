<html>
 <head>
  <title></title>
 </head>
 <body style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Dear <strong>{{{Recipient.Supervisor_User__c}}}</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">A new lead has been assigned to you. Please review the customer and project request details below.</p> <!-- Lead Details -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Lead Details</strong></p></td>
            </tr>
           </tbody>
          </table>
          <ul style="margin-top:8px;
										   margin-bottom:24px;
										   padding-left:24px;">
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>First Name:</strong>&nbsp;{{{Recipient.FirstName}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Last Name:</strong>&nbsp;{{{Recipient.LastName}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Email:</strong>&nbsp;{{{Recipient.Email}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Phone:</strong>&nbsp;{{{Recipient.Phone}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Company:</strong>&nbsp;{{{Recipient.Company}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Project Request Type:</strong>&nbsp;{{{Recipient.Project_Request_Quotation_Type__c}}}</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Project Description:</strong>&nbsp;{{{Recipient.Project_Description__c}}}</li>
          </ul> <!-- What Happens Next -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:20px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>What happens next?</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please review the assigned lead details and follow up with the customer as required for the next stage of the project enquiry process.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please ensure the customer receives timely guidance and any required follow-up regarding their project request.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because a new lead was assigned for supervisor follow-up.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>