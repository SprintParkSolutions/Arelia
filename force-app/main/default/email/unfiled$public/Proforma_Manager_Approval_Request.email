<html>
 <head>
  <title></title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 20px 0;
										  font-size:22px;
										  line-height:1.4;
										  font-family:Times New Roman,Times,serif;
										  color:#1f1f1f;"><strong>Manager Approval Required</strong></p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Hello Manager,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">The client has <strong style="color:#2e844a;">approved</strong> the Proforma Invoice shared for the interior project <strong>[OPPORTUNITY_NAME]</strong>.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please review the proforma details and provide your <strong>final internal approval</strong> to proceed with the next stages of execution.</p> <!-- Proforma Summary -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:20px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Proforma Summary</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:24px;
											  background-color:#faf8f3;
											  border-left:3px solid #c9a75d;" width="100%">
           <tbody>
            <tr>
             <td style="padding:16px 10px 10px 18px;
													   width:210px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Project Name:</strong></td>
             <td style="padding:16px 18px 10px 15px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">[OPPORTUNITY_NAME]</td>
            </tr>
            <tr>
             <td style="padding:0 10px 10px 18px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Client Name:</strong></td>
             <td style="padding:0 18px 10px 15px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">[CLIENT_NAME]</td>
            </tr>
            <tr>
             <td style="padding:0 10px 16px 18px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Client Approval Status:</strong></td>
             <td style="padding:0 18px 16px 15px;
													   vertical-align:top;
													   font-size:18px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;"><strong style="color:#2e844a;">Approved</strong></td>
            </tr>
           </tbody>
          </table> <!-- Client Feedback -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:24px;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#faf8f3;
													   border-left:3px solid #c9a75d;
													   padding:16px 18px;"><p style="margin:0 0 8px 0;
														  font-size:18px;
														  line-height:1.5;
														  font-family:Times New Roman,Times,serif;
														  color:#222222;"><strong>Client Feedback (if any):</strong></p> <p style="margin:0;
														  font-size:18px;
														  line-height:1.5;
														  font-family:Times New Roman,Times,serif;
														  color:#555555;">[CLIENT_COMMENTS]</p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">The approved Proforma Invoice reviewed by the client is attached to this email for your reference.</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">To proceed, please click the button below to review and provide your approval:</p> <!-- Main Approval Button -->
          <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;
											  margin:22px 0 24px 0;">
           <tbody>
            <tr>
             <td align="center" style="background-color:#1b1b1b;
													   border:1px solid #c9a75d;
													   padding:12px 24px;
													   text-align:center;"><a href="[MANAGER_LINK_URL]" style="font-size:17px;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#ffffff;
														  text-decoration:none;
														  font-weight:bold;
														  display:inline-block;">Review &amp; Approve Proforma </a></td>
            </tr>
           </tbody>
          </table> <!-- Professional Fallback Link -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#fbf8f1;
													   border:1px solid #e3d2a8;
													   border-left:4px solid #c9a75d;
													   padding:16px 18px;"><p style="margin:0 0 7px 0;
														  font-size:15px;
														  line-height:1.5;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#444444;"><strong>Unable to use the button above?</strong></p> <p style="margin:0 0 10px 0;
														  font-size:14px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#666666;">You can securely access the manager approval page using the link below.</p> <p style="margin:0;
														  font-size:14px;
														  line-height:1.5;
														  font-family:Arial,Helvetica,sans-serif;"><a href="[MANAGER_LINK_URL]" style="color:#9A6D1F;
															  text-decoration:none;
															  font-weight:bold;">Open Proforma Approval Page › </a></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Regards,<br /> <strong>Arelia Team</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because a client-approved Proforma Invoice requires final management approval.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>