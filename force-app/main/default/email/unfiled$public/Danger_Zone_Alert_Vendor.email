<html>
 <head>
  <title></title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Dear <strong>{{VendorName}}</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">This notification is to inform you that the task <strong>{{TaskSubject}}</strong>, associated with Vendor Assignment <strong>{{AssignmentName}}</strong> under project <strong>{{ProjectName}}</strong>, has exceeded the defined threshold timeline.</p> <!-- Danger Zone Alert -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#fff4f4;
													   border:1px solid #d79a9a;
													   border-left:4px solid #b94a48;
													   padding:16px 18px;"><p style="margin:0 0 6px 0;
														  font-size:18px;
														  line-height:1.5;
														  font-family:Times New Roman,Times,serif;
														  color:#7a1f1f;"><strong>Danger Zone Alert</strong></p> <p style="margin:0;
														  font-size:16px;
														  line-height:1.6;
														  font-family:Times New Roman,Times,serif;
														  color:#7a1f1f;">This task has crossed the approved project timeline threshold and requires your immediate attention.</p></td>
            </tr>
           </tbody>
          </table> <!-- Task Details -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Task Details</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Task</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{TaskSubject}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Vendor Assignment</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{AssignmentName}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Project</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{ProjectName}}</td>
            </tr>
            <tr>
             <td style="width:40%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Original Due Date</strong></td>
             <td style="width:60%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#9b1c1c;"><strong>{{DueDate}}</strong></td>
            </tr>
           </tbody>
          </table> <!-- Why This Requires Attention -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Why This Requires Attention</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">As per project governance standards, tasks that exceed the approved threshold timeline are flagged because they may impact dependent activities, overall project milestones, and final deliverables.</p> <!-- Action Required -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Action Required</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please prioritize the pending task and take the necessary steps to complete it as soon as possible.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Timely resolution will help prevent further escalation and ensure alignment with the agreed project delivery commitments.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Thank you for your prompt attention and cooperation.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because an assigned project task has exceeded its defined timeline threshold.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>