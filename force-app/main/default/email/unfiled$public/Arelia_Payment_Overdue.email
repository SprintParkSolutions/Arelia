<html>
 <head>
  <title>Payment Overdue</title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Dear <strong>{{{Payment_Term__c.Project__r.Client__r.FirstName}}}</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">We hope you are doing well.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">This is an important notification regarding an overdue payment for your project <strong>{{{Payment_Term__c.Project__r.Name}}}</strong>.</p> <!-- Payment Details -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Payment Details</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Payment Status</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#9b1c1c;"><strong>OVERDUE</strong></td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Payment Term</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>{{{Payment_Term__c.Name}}}</strong></td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Due Date</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>{{{Payment_Term__c.Due_Date__c}}}</strong></td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Amount Due</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>{{{Payment_Term__c.Percentage__c}}}%</strong> of Project Value</td>
            </tr>
           </tbody>
          </table> <!-- Action Required -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Action Required</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Your payment is now overdue. Please complete the payment as soon as possible to help avoid delays to your project timeline.</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">You can log in to the Arelia Client Portal to review your project and payment information.</p> <!-- Client Portal Button -->
          <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;
											  margin:22px 0 24px 0;">
           <tbody>
            <tr>
             <td align="center" style="background-color:#1b1b1b;
													   border:1px solid #c9a75d;
													   padding:12px 24px;
													   text-align:center;"><a href="https://www.areliaspace.com" style="font-size:17px;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#ffffff;
														  text-decoration:none;
														  font-weight:bold;
														  display:inline-block;">Login to Arelia Client Portal </a></td>
            </tr>
           </tbody>
          </table> <!-- Payment Note -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#fbf8f1;
													   border-left:4px solid #c9a75d;
													   padding:14px 18px;"><p style="margin:0;
														  font-size:16px;
														  line-height:1.6;
														  font-family:Times New Roman,Times,serif;
														  color:#555555;">If you have already completed this payment, please disregard this notification.</p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent regarding an overdue payment for your Arelia project.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>