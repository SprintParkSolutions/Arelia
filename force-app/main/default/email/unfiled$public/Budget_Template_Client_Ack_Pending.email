<html>
 <head>
  <title></title>
 </head>
 <body style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Hello <strong>{{CLIENT_NAME}}</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Thank you for approving the budget estimation for <strong>{{OPPORTUNITY_NAME}}</strong>.</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">We have successfully recorded your approval. The budget has now been forwarded to our Manager for the <strong>final sign-off</strong>.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">You will receive a final confirmation email once the Manager completes the review and validates the budget.</p> <!-- Next Steps -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Next Steps</strong></p></td>
            </tr>
           </tbody>
          </table>
          <ul style="margin-top:8px;
										   margin-bottom:24px;
										   padding-left:24px;">
           <li style="margin-bottom:12px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Manager Review:</strong>&nbsp;In Progress</li>
           <li style="margin-bottom:12px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>Final Confirmation Email:</strong>&nbsp;Pending</li>
          </ul> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">If you have any questions in the meantime, please feel free to contact your assigned supervisor.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent to confirm that your budget approval has been forwarded for final management review.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>