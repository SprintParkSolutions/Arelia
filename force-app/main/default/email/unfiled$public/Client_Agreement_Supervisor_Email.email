<html>
 <head>
  <title></title>
 </head>
 <body style="height:auto;
             min-height:auto;
             margin:0;
             padding:0;
             background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
              border-collapse:collapse;
              background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
                              width:100%;
                              background-color:#ffffff;
                              border:2px solid #c9a75d;
                              border-collapse:collapse;" width="100%">
       <!-- EMAIL BANNER -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
                                            width:100%;
                                            max-width:100%;
                                            height:auto;
                                            border:0;" title="Arelia Email Banner Image" /></td>
        </tr>
        <!-- EMAIL CONTENT -->
        <tr>
         <td style="padding:30px 34px 32px 34px;">
          <p style="margin:0 0 18px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">Hello,</p>
          <p style="margin:0 0 18px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">The client has successfully completed the digital signing of the Client Agreement.</p>
          <p style="margin:0 0 22px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">Please find the signed agreement details below for your reference.</p>
          <!-- SIGNED AGREEMENT DETAILS -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
                                              border-collapse:collapse;
                                              margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
                                                       padding-top:20px;">
              <p style="margin:0;
                                                          font-size:20px;
                                                          line-height:1.4;
                                                          font-family:Times New Roman,Times,serif;
                                                          color:#1f1f1f;"><strong>Signed Agreement Details</strong></p>
             </td>
            </tr>
           </tbody>
          </table>
          <ul style="margin-top:8px;
                                           margin-bottom:24px;
                                           padding-left:24px;">
           <li style="margin-bottom:10px;
                                               font-size:18px;
                                               line-height:1.5;
                                               font-family:Times New Roman,Times,serif;
                                               color:#222222;"><strong>Client Email:</strong>&#xa0;{{CLIENT_EMAIL}}</li>
           <li style="margin-bottom:10px;
                                               font-size:18px;
                                               line-height:1.5;
                                               font-family:Times New Roman,Times,serif;
                                               color:#222222;"><strong>Supervisor Email:</strong>&#xa0;{{SUPERVISOR_EMAIL}}</li>
           <li style="margin-bottom:10px;
                                               font-size:18px;
                                               line-height:1.5;
                                               font-family:Times New Roman,Times,serif;
                                               color:#222222;"><strong>Opportunity:</strong>&#xa0;{{OPPORTUNITY_NAME}}</li>
           <li style="margin-bottom:10px;
                                               font-size:18px;
                                               line-height:1.5;
                                               font-family:Times New Roman,Times,serif;
                                               color:#222222;"><strong>Signed Date:</strong>&#xa0;{{SIGNED_DATE}}</li>
          </ul>
          <!-- EXTERNAL FILE LINKS SECTION -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
                                              border-collapse:collapse;
                                              margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
                                                       padding-top:20px;">
              <p style="margin:0;
                                                          font-size:20px;
                                                          line-height:1.4;
                                                          font-family:Times New Roman,Times,serif;
                                                          color:#1f1f1f;"><strong>External File Links</strong></p>
             </td>
            </tr>
           </tbody>
          </table>
          <p style="margin:0 0 14px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">You can access additional agreement-related files using the links provided below.</p>
          <div style="margin:0 0 24px 0;
                                            font-size:16px;
                                            line-height:1.7;
                                            font-family:Times New Roman,Times,serif;
                                            color:#222222;
                                            overflow-wrap:anywhere;
                                            word-wrap:break-word;">{{EXTERNAL_FILE_LINKS}}</div>
          <!-- SIGNED DOCUMENT SECTION -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
                                              border-collapse:collapse;
                                              margin-bottom:20px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
                                                       padding-top:20px;">
              <p style="margin:0;
                                                          font-size:20px;
                                                          line-height:1.4;
                                                          font-family:Times New Roman,Times,serif;
                                                          color:#1f1f1f;"><strong>Signed Document</strong></p>
             </td>
            </tr>
           </tbody>
          </table>
          <p style="margin:0 0 22px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">The signed PDF is attached to this email and has also been stored against the Opportunity record in Salesforce for future reference.</p>
          <!-- NEXT STEPS SECTION -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
                                              border-collapse:collapse;
                                              margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
                                                       padding-top:20px;">
              <p style="margin:0;
                                                          font-size:20px;
                                                          line-height:1.4;
                                                          font-family:Times New Roman,Times,serif;
                                                          color:#1f1f1f;"><strong>Next Steps</strong></p>
             </td>
            </tr>
           </tbody>
          </table>
          <p style="margin:0 0 22px 0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">Please review the signed agreement and proceed with the appropriate next steps for the project.</p>
          <p style="margin:0;
                                          font-size:18px;
                                          line-height:1.5;
                                          font-family:Times New Roman,Times,serif;
                                          color:#222222;">Warm regards,
           <br />
           <strong>Team Arelia</strong></p>
         </td>
        </tr>
        <!-- FOOTER -->
        <tr>
         <td align="center" style="background-color:#171717;
                                       border-top:2px solid #C99A3D;
                                       padding:24px 32px 22px 32px;
                                       text-align:center;">
          <p style="margin:0 0 5px 0;
                                          font-size:24px;
                                          line-height:1.3;
                                          font-family:Times New Roman,Times,serif;
                                          color:#D6B36A;
                                          font-weight:bold;
                                          text-align:center;">Arelia</p>
          <p style="margin:0 0 18px 0;
                                          font-size:11px;
                                          line-height:1.5;
                                          font-family:Arial,Helvetica,sans-serif;
                                          color:#C99A3D;
                                          letter-spacing:2px;
                                          text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
                                              border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
                                                       padding-top:16px;
                                                       text-align:center;">
              <p style="margin:0 0 5px 0;
                                                          font-size:11px;
                                                          line-height:1.6;
                                                          font-family:Arial,Helvetica,sans-serif;
                                                          color:#8F887F;
                                                          text-align:center;">This email was sent because a Client Agreement has been digitally signed.</p>
              <p style="margin:0;
                                                          font-size:11px;
                                                          line-height:1.6;
                                                          font-family:Arial,Helvetica,sans-serif;
                                                          color:#8F887F;
                                                          text-align:center;">© 2026 Arelia. All rights reserved.</p>
             </td>
            </tr>
           </tbody>
          </table>
         </td>
        </tr>
       </tbody>
      </table>
     </td>
    </tr>
   </tbody>
  </table>
 </body>
</html>