<html>
 <head>
  <title></title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Hi <strong>Team</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Project <strong>{{PROJECT_NAME}}</strong> has reached <strong>{{COMPLETION_PERCENTAGE}}</strong> completion.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Based on the current project progress, the payment installment(s) listed below are now due for collection from the client.</p> <!-- Milestone Status -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#fbf8f1;
													   border:1px solid #e3d2a8;
													   border-left:4px solid #c9a75d;
													   padding:16px 18px;"><p style="margin:0 0 5px 0;
														  font-size:18px;
														  line-height:1.5;
														  font-family:Times New Roman,Times,serif;
														  color:#5f471f;"><strong>Payment Milestone Reached</strong></p> <p style="margin:0;
														  font-size:16px;
														  line-height:1.6;
														  font-family:Times New Roman,Times,serif;
														  color:#6d604a;">The project has reached the required completion milestone and the corresponding client payment is now due.</p></td>
            </tr>
           </tbody>
          </table> <!-- Project Details -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Project Milestone Details</strong></p></td>
            </tr>
           </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:0 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Project Name</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;">{{PROJECT_NAME}}</td>
            </tr>
            <tr>
             <td style="width:42%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   background-color:#fbf8f1;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>Project Completion</strong></td>
             <td style="width:58%;
													   padding:12px 14px;
													   border:1px solid #e3d2a8;
													   font-size:17px;
													   line-height:1.5;
													   font-family:Times New Roman,Times,serif;
													   color:#222222;"><strong>{{COMPLETION_PERCENTAGE}}</strong></td>
            </tr>
           </tbody>
          </table> <!-- Due Installments -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Payment Installments Due</strong></p></td>
            </tr>
           </tbody>
          </table> <!-- Dynamic Installment Table -->
          <div style="margin:0 0 24px 0;
											font-size:17px;
											line-height:1.5;
											font-family:Times New Roman,Times,serif;
											color:#222222;">
           {{INSTALLMENT_TABLE}}
          </div> <!-- Action Required -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Action Required</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please follow up with the client regarding the outstanding installment(s) and ensure the required payment is collected before work proceeds to the next project milestone.</p> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Timely collection will help maintain continuity of project execution and avoid delays in subsequent activities.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because a project payment milestone has been reached and client payment collection is due.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>