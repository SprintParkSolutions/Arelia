<html>
 <head>
  <title></title>
 </head>
 <body aria-readonly="false" style="height:auto;
			 min-height:auto;
			 margin:0;
			 padding:0;
			 background-color:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
			  border-collapse:collapse;
			  background-color:#ffffff;" width="100%">
   <tbody>
    <tr>
     <td align="center" style="padding:0;">
      <table border="0" cellpadding="0" cellspacing="0" style="max-width:760px;
							  width:100%;
							  background-color:#ffffff;
							  border:2px solid #c9a75d;
							  border-collapse:collapse;" width="100%">
       <!-- Banner -->
       <tbody>
        <tr>
         <td style="padding:0;"><img alt="Arelia Email Banner Image" src="{[devName:Arelia_Email_Banner_Image]}" style="display:block;
											width:100%;
											max-width:100%;
											height:auto;
											border:0;" title="Arelia Email Banner Image" /></td>
        </tr> <!-- Main Email Content -->
        <tr>
         <td style="padding:30px 34px 32px 34px;"><p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Hello <strong>Arelia Manager</strong>,</p> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">This is a notification regarding the internal review of project <strong>{{OPPORTUNITY_NAME}}</strong>.</p> <!-- Current Status -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Current Status</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">The budget has been <strong>re-submitted for manager approval</strong> after the Supervisor updated the estimates based on your previous feedback.</p> <!-- Context for Revision -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Context for Revision</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 14px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">The following changes were requested during your previous review:</p> <!-- Manager Remarks -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin:18px 0 24px 0;" width="100%">
           <tbody>
            <tr>
             <td style="background-color:#fbf8f1;
													   border-left:4px solid #c9a75d;
													   padding:15px 18px;"><p style="margin:0;
														  font-size:17px;
														  line-height:1.6;
														  font-family:Times New Roman,Times,serif;
														  font-style:italic;
														  color:#555555;">“{{MANAGER_REMARKS}}”</p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">The team has addressed the requested changes. Please review the updated budget figures and confirm that the revised proposal meets the required project and compliance expectations.</p> <!-- Action Required -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:20px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Action Required</strong></p></td>
            </tr>
           </tbody>
          </table> <p style="margin:0 0 18px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please review the revised budget and provide your managerial decision using the button below.</p> <!-- Review Revised Budget Button -->
          <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;
											  margin:22px 0 24px 0;">
           <tbody>
            <tr>
             <td align="center" style="background-color:#1b1b1b;
													   border:1px solid #c9a75d;
													   padding:12px 24px;
													   text-align:center;"><a href="{{APPROVAL_LINK}}" style="font-size:17px;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#ffffff;
														  text-decoration:none;
														  font-weight:bold;
														  display:inline-block;">Review Revised Budget </a></td>
            </tr>
           </tbody>
          </table> <!-- Next Steps -->
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;
											  margin-bottom:18px;" width="100%">
           <tbody>
            <tr>
             <td style="border-top:1px solid #e3d2a8;
													   padding-top:20px;"><p style="margin:0;
														  font-size:20px;
														  line-height:1.4;
														  font-family:Times New Roman,Times,serif;
														  color:#1f1f1f;"><strong>Next Steps</strong></p></td>
            </tr>
           </tbody>
          </table>
          <ul style="margin-top:8px;
										   margin-bottom:24px;
										   padding-left:24px;">
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>If Approved:</strong> The revised budget will be finalized and the Supervisor will be notified to proceed with the next stage.</li>
           <li style="margin-bottom:10px;
											   font-size:18px;
											   line-height:1.5;
											   font-family:Times New Roman,Times,serif;
											   color:#222222;"><strong>If Further Changes Are Required:</strong> You may request additional revisions and provide the necessary remarks for the Supervisor.</li>
          </ul> <p style="margin:0 0 22px 0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Please complete the review at your earliest convenience so the project can continue without unnecessary delay.</p> <p style="margin:0;
										  font-size:18px;
										  line-height:1.5;
										  font-family:Times New Roman,Times,serif;
										  color:#222222;">Warm regards,<br /> <strong>Team Arelia</strong></p></td>
        </tr> <!-- Short Professional Footer -->
        <tr>
         <td align="center" style="background-color:#171717;
									   border-top:2px solid #C99A3D;
									   padding:24px 32px 22px 32px;
									   text-align:center;"><p style="margin:0 0 5px 0;
										  font-size:24px;
										  line-height:1.3;
										  font-family:Times New Roman,Times,serif;
										  color:#D6B36A;
										  font-weight:bold;
										  text-align:center;">Arelia</p> <p style="margin:0 0 18px 0;
										  font-size:11px;
										  line-height:1.5;
										  font-family:Arial,Helvetica,sans-serif;
										  color:#C99A3D;
										  letter-spacing:2px;
										  text-align:center;">PREMIUM &amp; LUXURY INTERIOR DESIGNS</p>
          <table border="0" cellpadding="0" cellspacing="0" style="width:100%;
											  border-collapse:collapse;" width="100%">
           <tbody>
            <tr>
             <td align="center" style="border-top:1px solid #6E5427;
													   padding-top:16px;
													   text-align:center;"><p style="margin:0 0 5px 0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">This email was sent because a revised project budget requires management review.</p> <p style="margin:0;
														  font-size:11px;
														  line-height:1.6;
														  font-family:Arial,Helvetica,sans-serif;
														  color:#8F887F;
														  text-align:center;">© 2026 Arelia. All rights reserved.</p></td>
            </tr>
           </tbody>
          </table></td>
        </tr>
       </tbody>
      </table></td>
    </tr>
   </tbody>
  </table>
 </body>
</html>